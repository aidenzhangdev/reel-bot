# Bot (burner) account login. Copy this file to .env and fill it in.
IG_USERNAME=
IG_PASSWORD=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model instead of the latest free Flash model
GEMINI_MODEL=

# Your name, as the bot should think of itself
MY_NAME=

# Who the bot replies to: comma-separated usernames, or * for anyone
ALLOWED_USERS=

# Also reply to texts whose first word is this (any case). Leave blank to only reply to Reels.
TEXT_TRIGGER=bot

# 1 = print replies only, 0 = actually send them
DRY_RUN=1

# How often to check DMs (minimum 10). Lower = faster replies but more likely to get flagged.
POLL_SECONDS=10
MAX_REPLIES_PER_HOUR=20
# 1 = never repeat a recent reply, a style.md example, or a Reel comment (retries until it's new). 0 = allow it.
BLOCK_REPEATS=1
